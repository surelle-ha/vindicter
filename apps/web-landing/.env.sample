# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL from: Supabase dashboard → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Anon (public) key — safe to expose in client-side code (RLS enforced)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Site ─────────────────────────────────────────────────────────────────────
NUXT_PUBLIC_SITE_URL=https://vindicter.xyz

# ── Cloudflare Turnstile ─────────────────────────────────────────────────────
# Get your site key from: https://dash.cloudflare.com → Turnstile
# Use 1x00000000000000000000AA for local testing (always passes)
NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
