# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL from: Supabase dashboard → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Anon (public) key — safe to expose in client-side code (RLS enforced)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Site ─────────────────────────────────────────────────────────────────────
NUXT_PUBLIC_SITE_URL=https://vindicter.xyz

# ── Cloudflare Turnstile ─────────────────────────────────────────────────────
# Get both keys from: https://dash.cloudflare.com → Turnstile → your site
# Site key is public — exposed to the browser (used to render the widget)
# Use 1x00000000000000000000AA for local testing (always passes without a real widget)
NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Secret key is private — only used server-side (Supabase Edge Function / API route)
# Never prefix with NUXT_PUBLIC_ or it will leak to the browser
# TURNSTILE_SECRET_KEY=your_turnstile_secret_key
