# ── API ──────────────────────────────────────────────────────────────────────
# URL of the Vindicter API (apps/api). Defaults to localhost:4000 for local dev.
NUXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# ── Site ─────────────────────────────────────────────────────────────────────
NUXT_PUBLIC_SITE_URL=https://vindicter.xyz

# ── Cloudflare Turnstile ─────────────────────────────────────────────────────
# Get site key from: https://dash.cloudflare.com → Turnstile → your site
# Use 1x00000000000000000000AA for local testing (always passes)
NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
