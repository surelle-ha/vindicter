{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.vindicta.app",
  "productName": "Vindicter",
  "version": "0.5.0",
  "build": {
    "beforeDevCommand": "pnpm --filter @vindicter/desktop dev",
    "beforeBuildCommand": "pnpm --filter @vindicter/desktop generate",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../.output/public"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Vindicter",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' ipc: http://ipc.localhost http://localhost:* ws://localhost:* https://api.github.com https://openrouter.ai https://www.cshub.com https://huggingface.co https://cdn-lfs.huggingface.co https://cdn-lfs-us-1.huggingface.co"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": ["course-bin/*.va"],
    "externalBin": ["binaries/trivy"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwMEVCNzYwN0FDNDNGODgKUldTSVA4UjZZTGNPUUxQZTE5MUdiVUV2bTZUK0pIOHZUYWkrOTVIMTFEZmlIWE9UaStRTGY2WnoK",
      "endpoints": ["https://pub-1dcbd264e42f475e9f95858cc16ab6b7.r2.dev/releases/latest/update.json"],
      "dialog": false
    },
    "shell": {
      "open": true
    }
  }
}
