{
  "name": "@vindicter/api",
  "private": true,
  "version": "0.1.0",
  "description": "Vindicter REST API — NestJS + Fastify + TypeORM",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:run": "pnpm exec typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "migration:revert": "pnpm exec typeorm-ts-node-commonjs migration:revert -d src/data-source.ts",
    "migration:generate": "pnpm exec typeorm-ts-node-commonjs migration:generate -d src/data-source.ts",
    "migration:show": "pnpm exec typeorm-ts-node-commonjs migration:show -d src/data-source.ts",
    "seed": "ts-node src/database/seeds/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-fastify": "^10.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@nestjs/typeorm": "^10.0.0",
    "@types/nodemailer": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.4.5",
    "nanoid": "^3.3.7",
    "nodemailer": "^8.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.0.0",
    "@types/passport-jwt": "^4.0.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  }
}
