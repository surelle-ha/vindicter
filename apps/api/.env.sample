# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:password@localhost:5432/vindicter

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── App ───────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Seed defaults ─────────────────────────────────────────────────────────────
# Password for the default admin user created by the seed
SEED_ADMIN_EMAIL=admin@vindicter.xyz
SEED_ADMIN_PASSWORD=Admin@vindicter!2025
