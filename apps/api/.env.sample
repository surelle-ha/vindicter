# ── Database (PostgreSQL only) ────────────────────────────────────────────────
# Only postgres:// or postgresql:// URLs are accepted. MySQL/SQLite are not supported.
DATABASE_URL=postgres://postgres:password@localhost:5432/vindicter
# Set to "true" when connecting to a hosted PostgreSQL with TLS (e.g. Supabase, Neon, RDS)
DATABASE_SSL=false

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d

# --- Turnstile ---------------------------------------------------------------
# Set this to verify Cloudflare Turnstile tokens for protected login clients.
TURNSTILE_SECRET_KEY=
TURNSTILE_PROTECTED_CLIENTS=web-marketing
TURNSTILE_REQUIRED=false

# ── App ───────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of extra allowed origins beyond the defaults
# Defaults: http://localhost:3002, http://localhost:3003, https://vindicter.xyz, https://dashboard.vindicter.xyz
CORS_ORIGINS=

# ── Seed defaults ─────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@vindicter.xyz
SEED_ADMIN_PASSWORD=Admin@vindicter!2025

# --- SMTP / Marketing email --------------------------------------------------
# Required for POST /api/v1/marketing/campaigns/:id/send
# Use port 587 with SMTP_SECURE=false for STARTTLS, or 465 with SMTP_SECURE=true.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=marketing@vindicter.xyz
SMTP_FROM_NAME=Vindicter
