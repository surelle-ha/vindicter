# ── Desktop — GitHub OAuth (Tauri build-time) ─────────────────────────────────
# Required to build the desktop app with GitHub authentication.
# GITHUB_CLIENT_ID is baked into the Tauri binary at compile time via option_env!().
# Create an OAuth App at: https://github.com/settings/developers
# Authorization callback URL: http://localhost:1420 (or your Tauri deep-link scheme)
GITHUB_CLIENT_ID=your_github_oauth_app_client_id

# GITHUB_CLIENT_SECRET is used server-side only (future OAuth code exchange).
# Do NOT commit your real secret. This line is documentation only.
# GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# Web apps - Supabase
# Used by apps/web-landing and apps/web-dashboard while they are on Supabase.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Internal web-marketing app
NUXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# API SMTP transport for internal comms
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp_user
SMTP_PASS=smtp_password
SMTP_FROM_EMAIL=ops@vindicter.xyz
SMTP_FROM_NAME=Vindicter Ops
